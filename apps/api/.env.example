# Copiar a .env (desarrollo) y a .env.test (tests, con OTRA base de datos)

NODE_ENV=development
PORT=3001

# Postgres nativo. Bases: social_publisher y social_publisher_test
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/social_publisher
# Redis 8 en WSL, puerto 6381 (el 6379 es el Redis viejo de Laragon y el 6380 lo usa otro proyecto en Docker). Usar /0 en .env y /1 en .env.test
REDIS_URL=redis://localhost:6381/0

# Mail (avisos y reporte de errores)
ADMIN_EMAIL=admin@example.com
MAIL_FROM="Social Publisher <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR

# Auth del panel (un solo admin: el login usa ADMIN_EMAIL + este hash)
# Generar el hash con: npm run hash-password   (entre comillas simples por los $)
ADMIN_PASSWORD_HASH='CAMBIAR'
# Al menos 32 caracteres aleatorios. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR-por-un-valor-aleatorio-de-32-caracteres-o-mas
# Origen de la web (CORS con cookies)
WEB_ORIGIN=http://localhost:3000

# Clave para cifrar los tokens de Meta en la DB: 32 bytes en base64. NO cambiarla despues (los tokens guardados dejarian de descifrarse)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=CAMBIAR

# Meta (app de developers.facebook.com, ver checklist del README)
META_APP_ID=CAMBIAR
META_APP_SECRET=CAMBIAR
META_GRAPH_VERSION=v24.0
# Igual a la Redirect URI cargada en la app de Meta
META_REDIRECT_URI=http://localhost:3001/meta/callback

# Cloudflare R2 (bucket con acceso publico, token S3 con permiso de lectura/escritura sobre ese bucket)
R2_ACCOUNT_ID=CAMBIAR
R2_ACCESS_KEY_ID=CAMBIAR
R2_SECRET_ACCESS_KEY=CAMBIAR
R2_BUCKET=CAMBIAR
# Dominio publico del bucket (r2.dev o propio), sin barra final
R2_PUBLIC_BASE_URL=https://CAMBIAR.r2.dev
