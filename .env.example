# Configuracion para Docker. Crear el .env con: docker compose run --rm init
# (genera las claves y pide tu mail y contrasena); despues completar a mano lo que quede en CAMBIAR.
# Sin Docker, la configuracion va en apps/api/.env (ver apps/api/.env.example).

# --- Generado por el asistente ---
POSTGRES_PASSWORD=CAMBIAR
ADMIN_EMAIL=admin@example.com
# Hash bcrypt de tu contrasena, entre comillas simples (el $ rompe sin ellas)
ADMIN_PASSWORD_HASH='CAMBIAR'
JWT_SECRET=CAMBIAR
# NO cambiarla despues: los tokens guardados dejarian de descifrarse
TOKEN_ENC_KEY=CAMBIAR

# --- Puertos (solo si 3000 o 3001 estan ocupados) ---
# La web, la API y la redirect URI de Meta siguen a estos puertos solas.
# Acordate de cargar la nueva redirect URI en la app de Meta.
WEB_PORT=3000
API_PORT=3001

# --- Dominios propios (solo si lo pones en un servidor con HTTPS) ---
# WEB_ORIGIN=https://panel.tudominio.com
# NEXT_PUBLIC_API_URL=https://api.tudominio.com
# META_REDIRECT_URI=https://api.tudominio.com/meta/callback

# --- Mail (avisos de publicacion y de errores) ---
MAIL_FROM="Social Publisher <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR

# --- Meta: Facebook e Instagram (ver el tutorial del README) ---
META_APP_ID=CAMBIAR
META_APP_SECRET=CAMBIAR
META_GRAPH_VERSION=v24.0

# --- Cloudflare R2: bucket con acceso publico ---
R2_ACCOUNT_ID=CAMBIAR
R2_ACCESS_KEY_ID=CAMBIAR
R2_SECRET_ACCESS_KEY=CAMBIAR
R2_BUCKET=CAMBIAR
R2_PUBLIC_BASE_URL=https://CAMBIAR.r2.dev

# --- Opcionales: Threads (los tres juntos) ---
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=http://localhost:3001/threads/callback

# --- Opcional: IA para sugerir copy y hashtags ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
